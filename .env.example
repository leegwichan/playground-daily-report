# 복사해서 .env 로 저장 후 채우세요. .env 는 gitignore.

# ─── LLM (Google Gemini — 무료 티어) ────────────────────
# https://aistudio.google.com/app/apikey 에서 발급
GOOGLE_API_KEY=AIza...

# ─── Discord Webhooks ───────────────────────────────────
# 채널마다 Server Settings → Integrations → Webhooks 에서 생성
DISCORD_WEBHOOK_DAILY=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_WEEKLY=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_MONTHLY=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_CS=https://discord.com/api/webhooks/.../...

# ─── Notion ─────────────────────────────────────────────
NOTION_API_TOKEN=secret_...

# ─── GitHub ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GIT_AUTHOR_EMAIL=you@example.com
